
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DiaryPage {
  id        String   @id @default(cuid())
  title     String   @default("Untitled page")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  elements PageElement[]
}

model PageElement{
  id String @id @default(cuid())
  type ElementType
  x Float @default(0)
  y Float @default(0)
  width Float @default(100)
  height Float @default(100)
  rotation Float @default(0)
  zIndex Int @default(0)
  content String? @db.Text       // content can store text, image,sticker or any drawing data
  pageId String                 // connects each elements to its diray page
  page DiaryPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ElementType{
  TEXT
  IMAGE
  STICKER
  DRAWING
}